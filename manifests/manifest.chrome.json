{
  "manifest_version": 3,
  "name": "Курс НБУ",
  "version": "2.4",
  "description": "Офіційний курс валют НБУ до гривні: USD, EUR, GBP, PLN, CNY, CHF, JPY, CAD, AUD, TRY. Темна тема, прапори, 2 мови інтерфейсу.",
  "key": "---",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Курс НБУ",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://bank.gov.ua/*"]
}
