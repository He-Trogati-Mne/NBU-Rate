{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "He-Trogati-Mne",
  "homepage_url": "https://he-trogati-mne.github.io/NBU-Rate/",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://bank.gov.ua/*"
  ],
  "minimum_chrome_version": "88"
}
