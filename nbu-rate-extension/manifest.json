{
  "manifest_version": 3,
  "name": "Курс НБУ",
  "version": "1.3",
  "description": "Показує офіційний курс валют НБУ. Налаштовувана тема, мова та список валют.",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "He_Trogati_Mne@example.com",
      "strict_min_version": "109.0"
    }
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Курс НБУ",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://bank.gov.ua/*"]
}